{
  "expo": {
    "name": "CityOneTaxi",
    "slug": "cityonetaxi",
    "scheme": "cityonetaxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cityonetaxi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CityOneTaxi needs your location to show nearby drivers and track your ride.",
        "NSLocationAlwaysUsageDescription": "CityOneTaxi needs your location to provide live driver tracking.",
        "NSCameraUsageDescription": "CityOneTaxi needs camera access for profile avatar and document verification.",
        "NSPhotoLibraryUsageDescription": "CityOneTaxi needs photo library access for profile avatar upload."
      }
    },
    "android": {
      "package": "com.cityonetaxi.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBZhUreM7E2U5krpAMizvpj2qoqgcQuuWc"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CityOneTaxi to use your location for real-time live navigation and booking tracking.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CityOneTaxi to access your photos for profile and vehicle document uploads.",
          "cameraPermission": "Allow CityOneTaxi to access your camera to take profile photos and verify KYC documents."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "https://taxi-backend.toptechsoftwaresolutions.in/api",
      "backendUrl": "https://taxi-backend.toptechsoftwaresolutions.in",
      "googleMapsApiKey": "AIzaSyBZhUreM7E2U5krpAMizvpj2qoqgcQuuWc",
      "eas": {
        "projectId": "bc277ed2-5ce7-4f47-a176-19f631fc6bac"
      }
    },
    "owner": "top_tech_developers"
  }
}

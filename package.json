{
  "name": "cabtaxi-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "start:lan": "node node_modules/expo/bin/cli start --lan",
    "start:tunnel": "node node_modules/expo/bin/cli start --tunnel",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:apk": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.6.7",
    "expo": "^57.0.22",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-location": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.0",
    "babel-preset-expo": "~57.0.0",
    "react-refresh": "^0.19.0"
  },
